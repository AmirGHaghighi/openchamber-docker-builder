# Required: browser UI password (container fails fast without it).
OPENCHAMBER_UI_PASSWORD=change-me-to-something-long

# Image tag to run (matches a published GHCR tag; pin the 4-part tag).
IMAGE_TAG=2.2.0-2.0.25-0.0.1

# --- Docker socket (opt-in, trusted single-user hosts only) ---
# Host socket GID for non-root docker access inside the container.
# Find it with: stat -c %g /var/run/docker.sock
# Pair with uncommenting the /var/run/docker.sock mount in docker-compose.yml.
# DOCKER_GID=

# --- Server bind + auth ---
# Bind address for the web server (upstream env, bare IP, no scheme).
# Empty = entrypoint default 0.0.0.0. Explicit --host flag wins.
# OPENCHAMBER_HOST=0.0.0.0

# LAN address pairing links offer, e.g. http://192.168.1.20:3000
# OPENCHAMBER_LAN_URL=

# Entrypoint env (repo-local): translated to --port by docker-entrypoint.sh.
# Explicit --port flag wins. For network_mode: host, pair with
# OPENCHAMBER_HOST=127.0.0.1 and matching compose command override.
# OPENCHAMBER_PORT=3000

# Browser sign-in lifetime in hours when "trust this device" is off (default 12).
# OPENCHAMBER_UI_SESSION_TTL_HOURS=12

# Sign-in lifetime in days on a trusted device (default 7).
# OPENCHAMBER_UI_TRUSTED_SESSION_TTL_DAYS=7

# Headless mode: API routes only, no browser UI (true/1).
# OPENCHAMBER_API_ONLY=

# Origins allowed to frame OpenChamber, space-separated (default: self + apps).
# OPENCHAMBER_FRAME_ANCESTORS=

# --- OpenCode server ---
# Use an external OpenCode server instead of the managed one.
# Set BOTH together; OPENCODE_HOST alone without SKIP_START misbehaves.
# OPENCODE_HOST=http://host.docker.internal:4096
# OPENCODE_SKIP_START=true

# Port of external OpenCode server (with OPENCODE_SKIP_START=true).
# OPENCODE_PORT=

# Bind hostname for the managed OpenCode server (default 127.0.0.1).
# OPENCHAMBER_OPENCODE_HOSTNAME=

# Secret signing UI auth tokens. Set a long random value for persistent
# deployments so browser sessions survive volume recreation. Note: while set,
# global sign-out ("Sign out everywhere") is unavailable.
# OPENCODE_JWT_SECRET=

# Path to the opencode executable (when not using the bundled one).
# OPENCODE_BINARY=

# --- Data dirs ---
# Override the data directory (default ~/.config/openchamber).
# OPENCHAMBER_DATA_DIR=

# Relocate managed chat directories (default <data-dir>/chats).
# OPENCHAMBER_CHATS_DIR=

# --- Terminal + Git ---
# Shell for terminal sessions.
# OPENCHAMBER_TERMINAL_SHELL=

# Git executable override.
# OPENCHAMBER_GIT_BINARY=

# --- Voice + tunnels ---
# API key for OpenChamber voice features (never sent to custom servers).
# OPENAI_API_KEY=

# ngrok auth token for tunnel commands.
# NGROK_AUTHTOKEN=

# --- Enterprise mode (containers) ---
# OPENCHAMBER_ENTERPRISE_MODE=1
# OPENCHAMBER_ALLOW_NETWORK_ACCESS=1
# OPENCHAMBER_ALLOWED_EXTENSIONS=
# OPENCHAMBER_RELAY_URL=
# OPENCHAMBER_JEV_URL=
# OPENCHAMBER_JEV_MODEL=
# OPENCHAMBER_JEV_API_KEY=

# --- App behavior ---
# API response compression: true/1 force on, false/0 force off.
# OPENCHAMBER_COMPRESS_API=

# Verbose HTTP request logs (true/1).
# OPENCHAMBER_VERBOSE_REQUEST_LOGS=

# Override the update-check endpoint (leave unset normally).
# OPENCHAMBER_UPDATE_API_URL=

# Force package manager for updates when auto-detection is wrong.
# OPENCHAMBER_PACKAGE_MANAGER=

# Outgoing proxy for OpenChamber's own requests (lowercase works too).
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
