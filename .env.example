# Required: browser UI password (container fails fast without it).
OPENCHAMBER_UI_PASSWORD=change-me-to-something-long

# Image tag to run (matches a published GHCR tag).
IMAGE_TAG=2.2.0

# Optional: LAN address pairing links offer, e.g. http://192.168.1.20:3000
# OPENCHAMBER_LAN_URL=

# Optional: use an external OpenCode server instead of the managed one.
# OPENCODE_HOST=http://host.docker.internal:4096
# OPENCODE_SKIP_START=true
